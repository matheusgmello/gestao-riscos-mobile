## Database settings
DATABASE_NAME=gestao_risco_ufsm
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433

## Django settings
SECRET_KEY=django-insecure-development-only-key
DEBUG=True

## MinIO / object storage (fotos de evidência dos monitoramentos)
## Sem estas variáveis, as fotos ficam no sistema de arquivos local.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gestao-risco
## Domínio que o CELULAR consegue abrir para baixar a imagem.
## Emulador Android: 10.0.2.2:9000 · celular físico: adb reverse tcp:9000 -> localhost:9000
MINIO_PUBLIC_DOMAIN=10.0.2.2:9000
